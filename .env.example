# ---- Chain ----
RPC_URL=https://rpc.robinhood.<fill-in>          # Robinhood Chain RPC (chain id 4663)
CHAIN_ID=4663
KEEPER_PRIVATE_KEY=0x...                          # the keeper wallet (must be a keeper on all 3 contracts)

# ---- Contract addresses (from your forge deploy) ----
REGISTRY_ADDRESS=0x...
ROUTER_ADDRESS=0x...
ALLOCATIONS_ADDRESS=0x...

# Defaults used when a launch registration omits them
DEFAULT_PAIR_ASSET=0x...                          # USDG address on Robinhood Chain
DEFAULT_LAUNCHPAD=0x...                           # Pons escrow / launchpad address
DEPLOY_BLOCK=0                                     # block the Router was deployed at (for event backfill)
FEED_LOOKBACK_BLOCKS=200000                        # how far back /feed scans for recent payouts

# ---- X (Twitter) OAuth 2.0 (PKCE) ----
X_CLIENT_ID=...
X_CLIENT_SECRET=...                               # confidential client; PKCE still used
X_REDIRECT_URI=http://localhost:8787/auth/x/callback
X_SCOPES=tweet.read users.read offline.access

# ---- Server ----
PORT=8787
FRONTEND_URL=http://localhost:5173               # where /auth callback redirects back to
COLLECT_CRON=*/5 * * * *                          # every 5 min
COLLECT_BATCH_SIZE=40
AUTO_PUSH=false                                    # if true, keeper auto-pushes fees to bound wallets
DB_PATH=./hoodpaid.db
ADMIN_TOKEN=change-me                              # bearer token for /admin/* endpoints
